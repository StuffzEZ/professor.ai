rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users ───────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.size() < 2000;
    }

    // ─── Usage records (quota counters) ──────────────────────────────────
    match /users/{userId}/usage/{date} {
      allow read, write: if isAuthenticated()
                          && request.auth.uid == userId;
    }

    // ─── Private user lessons ────────────────────────────────────────────
    match /users/{userId}/lessons/{lessonId} {
      allow read:  if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated()
                     && request.auth.uid == userId
                     && !isCooldown(userId);
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // ─── Public lessons ──────────────────────────────────────────────────
    match /publicLessons/{lessonId} {
      allow read: if isAuthenticated();
      // On create, resource is null — use request.resource.data instead
      allow create: if isAuthenticated()
                      && request.resource.data.ownerId == request.auth.uid
                      && !isCooldown(request.resource.data.ownerId);
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // ─── User categories ─────────────────────────────────────────────────
    match /users/{userId}/categories/{catId} {
      allow read, write: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // ─── Progress ────────────────────────────────────────────────────────
    // On create/write, resource may be null — fall back to request.resource.data
    match /users/{userId}/progress/{progressId} {
      allow read, write: if isAuthenticated()
                          && request.auth.uid == userId
                          && (resource == null || resource.data.userId == request.auth.uid)
                          && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    // ─── Helpers ─────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    /** True while the account is in its first 7 days (cool-down period). */
    function isCooldown(uid) {
      if (!exists(/databases/$(database)/documents/users/$(uid))) return true;
      return get(/databases/$(database)/documents/users/$(uid)).data.cooldownUntil > request.time.millis;
    }
  }
}
