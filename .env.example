# ── Firebase (required) ──────────────────────────────────────────────────────
# Create these values in the Firebase Console → Project Settings → General → Your apps
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── App Check (opt-in — see private-setup/README.md) ─────────────────────────
# Set VITE_APPCHECK_ENABLED=true AFTER the deployment domain is registered
# in the reCAPTCHA Enterprise console. A misconfigured key returns HTTP 400
# and blocks ALL auth, so it is OFF by default.
# Get a site key from Firebase Console → App Check → reCAPTCHA Enterprise
VITE_APPCHECK_KEY=your_recaptcha_enterprise_site_key_here
VITE_APPCHECK_ENABLED=false

# ── Professor AI endpoint (optional) ─────────────────────────────────────────
# If configured, lessons will use this endpoint instead of Pollinations AI.
# Leave empty to fall back to free-tier Pollinations AI.
# IMPORTANT: VITE_PROFESSOR_API_KEY is injected at build time only — it is
# NOT committed to git. The .env.local file is in .gitignore.
VITE_PROFESSOR_API_URL=
VITE_PROFESSOR_API_KEY=
VITE_PROFESSOR_MODEL=gpt-4o-mini

# ── Build ─────────────────────────────────────────────────────────────────────
# Base path for GitHub Pages deployment. Leave as / if self-hosting elsewhere.
# For GitHub Pages under a repo named "professor.ai" the user is "matth",
# set BASE_PATH=/professor.ai; otherwise leave commented out.
# VITE_BASE_PATH=/