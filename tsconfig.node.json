{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "emitDeclarationOnly": true,
    "outDir": "./dist/node-types",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["vite.config.ts"]
}